        "scheduler": "beta57",
        "steps": 28,
        "cfg": 4.0,
        "vae_candidates": [
          "qwen_image_vae.safetensors",
          "QwenImage\\qwen_image_vae.safetensors",
          "QwenImage/qwen_image_vae.safetensors",
